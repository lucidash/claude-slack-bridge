# Slack 설정
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack 모드: http (기본, Events API + Public URL 필요) | socket (Socket Mode, App-Level Token 필요)
SLACK_MODE=http

# HTTP 모드용 — Slack Events API 서명 검증 시크릿
SLACK_SIGNING_SECRET=your-signing-secret

# Socket 모드용 — App-Level Token (xapp- 로 시작, Slack App 설정에서 발급)
# 발급 방법: api.slack.com/apps → Basic Information → App-Level Tokens → connections:write 스코프
SLACK_APP_TOKEN=xapp-your-app-token

# 허용된 Slack 사용자 ID (콤마 구분)
ALLOWED_USERS=U0XXXXXXXX,U0YYYYYYYY

# 서버 설정 (HTTP 모드: webhook 수신 / Socket 모드: 디버그 엔드포인트만 노출)
PORT=3005

# Claude Code 설정
CLAUDE_MODEL=opus
CLAUDE_ALLOWED_DIRS=~/projects
CLAUDE_SKIP_PERMISSIONS=true

# Codex App Server 설정 (!engine codex 사용 시)
# 비워두면 Codex CLI/선택 모델의 기본값 사용
CODEX_PATH=codex
CODEX_MODEL=
CODEX_EFFORT=
CODEX_ALLOWED_DIRS=~/projects

# 실행 권한: read-only | workspace-write | danger-full-access
CODEX_SANDBOX=danger-full-access
# 승인 정책: never (Slack 승인 중계 미지원)
CODEX_APPROVAL_POLICY=never
CODEX_NETWORK_ACCESS=true
CODEX_REQUEST_TIMEOUT_MS=30000

# 선택: 브리지 상태 파일 저장 경로 (기본값: ~/.claude/slack-bridge)
# BRIDGE_DATA_DIR=/path/to/slack-bridge-data

# OpenAI API Key (STT용)
OPENAI_API_KEY=sk-your-openai-api-key
